# ─── MyLedger Backend — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git (add it to .gitignore).

# ── Google Cloud Vision — Application Default Credentials (ADC) ───────────────
# Used for receipt scanning (OCR) — POST /api/ocr/receipt
#
# Your org disallows API keys, so we use a Service Account JSON instead.
#
# Setup steps:
#   1. Go to https://console.cloud.google.com → IAM & Admin → Service Accounts
#   2. Click "Create Service Account"
#      Name: myledger-vision   (any name)
#   3. Grant role: "Cloud Vision API User"  (or just "Viewer" scoped to Vision)
#   4. Open the service account → Keys tab → Add Key → Create new key → JSON
#   5. Download the .json file → save it as:
#        backend/service-account.json
#   6. Set the path below (relative to backend/ folder):
#
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ── JWT Secret ────────────────────────────────────────────────────────────────
# Change this in production. Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=myledger-dev-secret-change-in-prod

# ── Server Port (optional, default: 5000) ────────────────────────────────────
# PORT=5000
